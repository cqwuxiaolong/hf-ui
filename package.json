{
  "name": "hf-web-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hugging Face 模型搜索 / 文件大小查看 / 下载管理器（hf-mirror 镜像）",
  "license": "MIT",
  "author": "cqwuxiaolong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqwuxiaolong/hf-ui.git"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"PORT=2271 node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "build:native": "cargo build --release --manifest-path native/xet-dl/Cargo.toml --target-dir native/xet-dl/target && mkdir -p native/bin && cp -f native/xet-dl/target/release/xet-dl native/bin/xet-dl",
    "preview": "pnpm build && node server/index.js",
    "package:sea": "node scripts/build-sea.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/hub": "^2.17.11",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.21.0"
}
